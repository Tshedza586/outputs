{
  "name": "escape-villa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0" },
  "scripts": {
    "build": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && node scripts/copy-static.mjs",
    "start": "npm run build && node dist/server.js",
    "check": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
